# ============================================================
# Synora — ROOT .env (used by docker-compose.prod.yml)
# Copy to `.env` and fill in. NEVER commit the real .env.
# ============================================================

# ---------- Backend: Database (PostgreSQL) ----------
# Neon / Supabase / Railway / Cloud SQL etc. Add ?sslmode=require for hosted DBs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/synora?sslmode=require"

# ---------- Backend: Google Gemini (LLM + embeddings) ----------
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key"

# ---------- Backend: Pinecone (vector DB) ----------
# Index must be created beforehand: dimension=768, metric=cosine
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_ENV="us-east-1"
PINECONE_INDEX_NAME="synora"

# ---------- Backend: UploadThing (file storage) ----------
# From the UploadThing dashboard -> API Keys. It is a base64 string that decodes to
# {"apiKey":"sk_live_...","appId":"...","regions":["sea1"]}
UPLOADTHING_TOKEN="your_uploadthing_token"

# ---------- Backend: Redis (sessions + progress + cache) ----------
# docker-compose overrides this with redis://redis:6379 automatically.
# Use redis://localhost:6379 only when running the backend outside Docker.
REDIS_URL="redis://redis:6379"

# ---------- Google OAuth (shared by backend + frontend) ----------
# https://console.cloud.google.com/apis/credentials  -> OAuth 2.0 Client ID (Web)
# Authorized redirect URI:  <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ---------- Frontend (Next.js / NextAuth) ----------
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_random_32_byte_secret"
# Public URL users open in the browser (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Public URL of the backend as seen from the BROWSER. Baked in at build time,
# so rebuild the frontend image after changing it.
NEXT_PUBLIC_API_URL="http://localhost:8000"
# Server-side (container -> container) backend URL. docker-compose sets this already.
API_URL="http://backend:8000"

# Optional: comma-separated allowed origins for CORS (default *). Set to your frontend URL in production.
# CORS_ORIGINS="https://synora-frontend.onrender.com"
