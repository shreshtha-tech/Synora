# Synora backend (FastAPI) — copy to backend/.env
# Used by docker-compose.yml (dev) and `uvicorn main:app --reload` locally.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/synora?sslmode=require"
GEMINI_API_KEY="your_gemini_api_key"
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_ENV="us-east-1"
PINECONE_INDEX_NAME="synora"        # Existing index; schema/model detected automatically
UPLOADTHING_TOKEN="your_uploadthing_token"
REDIS_URL="redis://localhost:6379"   # docker-compose overrides with redis://redis:6379
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Large document resource limits (per backend process)
MAX_UPLOAD_MB=100
DOCUMENT_CONCURRENCY=2
LLM_CONCURRENCY=4
EMBEDDING_CONCURRENCY=2
EMBEDDING_BATCH_SIZE=16
ANALYSIS_CONTEXT_CHARS=24000

# Optional: comma-separated allowed origins for CORS (default *). Set to your frontend URL in production.
# CORS_ORIGINS="https://synora-frontend.onrender.com"
